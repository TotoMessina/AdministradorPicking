VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Public Web Push key. Private VAPID and scheduler keys belong ONLY in Edge secrets.
VITE_VAPID_PUBLIC_KEY=
# Optional: localhost-only push testing; worker does not cache development files.
VITE_ENABLE_DEV_PWA=false

# Failure alerts (docs/aviso-de-fallas.md). Empty DSN turns them off. The DSN is public by design.
VITE_SENTRY_DSN=
VITE_APP_VERSION=

# Clave visible en el navegador: solo para pruebas locales. Vacía = la IA pasa por el servidor (función ai-proxy,
# secreto GROQ_API_KEY en Supabase), con cupos y corte desde el Panel de plataforma.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.1-8b-instant
