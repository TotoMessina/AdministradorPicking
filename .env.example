VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Public Web Push key. Private VAPID and scheduler keys belong ONLY in Edge secrets.
VITE_VAPID_PUBLIC_KEY=
# Optional: localhost-only push testing; worker does not cache development files.
VITE_ENABLE_DEV_PWA=false

# Browser-visible key. For local testing only; use a server-side proxy in production.
VITE_GROQ_API_KEY=gsk_YOUR_KEY_HERE
VITE_GROQ_MODEL=qwen/qwen3.8-27b

# PickingUp Distributors API
VITE_PICKINGUP_API_TOKEN=
VITE_PICKINGUP_BASE_URL=https://mainapi-staging.pickingup.ar/api/external/distributors/v1
VITE_PICKINGUP_PRICELIST_CODE=LIST-PRINCIPAL
